# Signify Backend Environment Configuration

# Server
PORT=8080

# ML Services (gRPC endpoints)
SIGN_TO_TEXT_URL=localhost:50051
TEXT_TO_VOICE_URL=localhost:50052

# Database
POSTGRES_URL=postgres://user:pass@localhost:5432/signify?sslmode=disable

# Twilio Configuration
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Public URLs (required for Twilio webhooks)
# Use ngrok during development: ngrok http 8080
# Then set these to your ngrok URL
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
PUBLIC_WS_URL=wss://xxxx.ngrok-free.app

# Deepgram STT Configuration (Milestone 2)
# Get API key from https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs TTS Configuration (Human-like Voice)
# Get API key from https://elevenlabs.io
# Sign up for free tier: 10,000 characters/month
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Specify voice ID (defaults to "Rachel" - female American voice)
# Find more voices at https://elevenlabs.io/voice-library
# Common voices:
#   21m00Tcm4TlvDq8ikWAM = Rachel (Female, American) - DEFAULT
#   EXAVITQu4vr4xnSDxMaL = Bella (Female, American)
#   ErXwobaYiN019PkySvjV = Antoni (Male, American)
#   TxGEqnHWrfWFTfGW9XjX = Josh (Male, American)
#   pNInz6obpgDQGcFmaJgB = Adam (Male, American)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM


TWILIO_ACCOUNT_SID=
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.app
PUBLIC_WS_URL=wss://your-ngrok-url.ngrok-free.app
DEEPGRAM_API_KEY=