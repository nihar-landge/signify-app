# Signify Backend Configuration
# Copy this file to .env and fill in the values

# Server
PORT=8080

# Database
POSTGRES_URL=postgres://user:pass@localhost:5432/signify?sslmode=disable
REDIS_URL=localhost:6379

# ML Services (gRPC endpoints)
SIGN_TO_TEXT_URL=localhost:50051
TEXT_TO_VOICE_URL=localhost:50052

# =====================================================
# Twilio Configuration (for PSTN calls)
# Get these from your Twilio Console: https://console.twilio.com
# =====================================================

# Your Twilio Account SID (starts with AC)
TWILIO_ACCOUNT_SID=

# Your Twilio Auth Token
TWILIO_AUTH_TOKEN=

# Your Twilio phone number (must be verified)
# Format: +1234567890
TWILIO_PHONE_NUMBER=

# Webhook URL for Twilio callbacks (your public server URL)
# This needs to be publicly accessible for Twilio to call
# Example: https://your-server.com
TWILIO_WEBHOOK_URL=

# =====================================================
# WebRTC Configuration
# =====================================================

# TURN server credentials (optional, for production)
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=
# TURN_PASSWORD=

# =====================================================
# Deepgram STT Configuration (Speech-to-Text)
# Get API key from: https://console.deepgram.com
# =====================================================

DEEPGRAM_API_KEY=

# =====================================================
# ElevenLabs TTS Configuration (Human-like Voice)
# Get API key from: https://elevenlabs.io
# Free tier: 10,000 characters/month
# =====================================================

ELEVENLABS_API_KEY=

# Voice ID (optional - defaults to Rachel, female American voice)
# Find more voices at: https://elevenlabs.io/voice-library
# Common voice IDs:
#   21m00Tcm4TlvDq8ikWAM = Rachel (Female)
#   EXAVITQu4vr4xnSDxMaL = Bella (Female)
#   ErXwobaYiN019PkySvjV = Antoni (Male)
#   TxGEqnHWrfWFTfGW9XjX = Josh (Male)
#   pNInz6obpgDQGcFmaJgB = Adam (Male)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
